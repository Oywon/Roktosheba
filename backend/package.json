{
  "name": "roktosheba-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init --preview-feature",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "expire": "ts-node --transpile-only src/expire.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "helmet": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.10.1",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.18",
    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.14.2",
    "@types/supertest": "^2.0.14",
    "supertest": "^7.1.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vitest": "^1.5.5"
  }
}
