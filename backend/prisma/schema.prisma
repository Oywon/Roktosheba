generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Donor {
  id             String                @id @default(uuid())
  name           String
  phone          String                @unique
  bloodGroup     String
  district       String
  area           String?
  lastDonation   DateTime?
  age            Int?
  gender         String?
  available      Boolean               @default(true)
  consent        Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  expiresAt      DateTime
  reports        Int                   @default(0)
  contactRequests DonorContactRequest[] @relation("DonorContactRequests")
}

model DonorContactRequest {
  id                 String   @id @default(uuid())
  donorId            String
  donor              Donor    @relation("DonorContactRequests", fields: [donorId], references: [id])
  donorName          String?
  requesterName      String
  requesterPhone     String
  requesterMessage   String?
  donorPhone         String?
  donorPhoneVisible  Boolean  @default(false)
  requesterPhoneVisible Boolean @default(true)
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model EmergencyRequest {
  id           String   @id @default(uuid())
  bloodGroup   String
  hospital     String
  district     String
  contactPhone String
  unitsNeeded  String?
  note         String?
  fulfilled    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reports      Int      @default(0)
}

model Organization {
  id          String   @id @default(uuid())
  name        String   @unique
  founded     String
  description String
  websiteUrl  String
  contactPhone String?
}
